{
  "brand": "Mukamal",
  "tagline": "Design That Converts.",
  "version": "2.0.0",
  "source": "04_Mukamal_Web/DESIGN.md (single source of truth)",

  "colors": {
    "background": "#080808",
    "bg-elevated": "#0f0f0f",
    "surface": "rgba(255, 255, 255, 0.03)",
    "card": "rgba(255, 255, 255, 0.03)",
    "card-highest": "rgba(255, 255, 255, 0.06)",
    "accent": "#C6F135",
    "accent-alt": "#aad306",
    "accent-contrast": "#0e1a00",
    "accent-dim": "rgba(198, 241, 53, 0.60)",
    "accent-subtle": "rgba(198, 241, 53, 0.08)",
    "accent-glow": "rgba(198, 241, 53, 0.15)",
    "text": "#F0EDE6",
    "text-dim": "rgba(240, 237, 230, 0.7)",
    "text-muted": "rgba(240, 237, 230, 0.5)",
    "error": "#ff4d4d",
    "success": "#C6F135",
    "border": "rgba(255, 255, 255, 0.08)",
    "border-hover": "rgba(255, 255, 255, 0.15)",
    "glass-bg": "rgba(255, 255, 255, 0.03)",
    "glass-border": "rgba(255, 255, 255, 0.08)"
  },

  "typography": {
    "font-display": "'Bebas Neue', sans-serif",
    "font-body": "'DM Sans', sans-serif",
    "font-mono": "'Space Mono', monospace",
    "scale": {
      "hero": { "desktop": "clamp(100px, 12vw, 160px)", "mobile": "clamp(56px, 14vw, 80px)" },
      "h1": { "desktop": "96px", "mobile": "56px" },
      "h2": { "desktop": "72px", "mobile": "40px" },
      "h3": { "desktop": "36px", "mobile": "28px" },
      "h4": { "desktop": "24px", "mobile": "20px" },
      "body-lg": "20px",
      "body": "16px",
      "body-sm": "14px",
      "label": "12px"
    },
    "line-height": {
      "display": 0.9,
      "heading": 1.0,
      "body": 1.7,
      "label": 1.3
    }
  },

  "spacing": {
    "unit": 8,
    "scale": {
      "1": "8px",
      "2": "16px",
      "3": "24px",
      "4": "32px",
      "6": "48px",
      "8": "64px",
      "12": "96px",
      "16": "128px",
      "24": "192px"
    }
  },

  "layout": {
    "container-max": "1280px",
    "container-wide": "1440px",
    "gutter": "clamp(1.5rem, 4vw, 3rem)",
    "grid-columns": { "desktop": 12, "mobile": 4 },
    "grid-gap": "24px"
  },

  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },

  "shadows": {
    "card": "0 1px 2px rgba(0,0,0,0.6), 0 4px 24px rgba(0,0,0,0.4)",
    "glow": "0 0 40px rgba(198, 241, 53, 0.05), 0 0 80px rgba(198, 241, 53, 0.03)",
    "elevated": "0 8px 40px rgba(0, 0, 0, 0.6)",
    "neon": "0 0 24px rgba(198, 241, 53, 0.12)"
  },

  "glass": {
    "bg": "rgba(255, 255, 255, 0.03)",
    "blur": "blur(10px)",
    "border": "1px solid rgba(255, 255, 255, 0.08)"
  },

  "opacity": {
    "headline": 1.0,
    "subheading": 0.7,
    "body": 0.87,
    "label": 0.5
  },

  "animation": {
    "easing": {
      "out": "cubic-bezier(0.2, 0, 0, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "reveal": "power3.out",
      "hero": "power4.out",
      "playful": "elastic.out(1, 0.3)"
    },
    "duration": {
      "hero-total": 1.5,
      "section-reveal": 0.8,
      "micro": 0.3,
      "count-up": 2.0
    },
    "stagger": {
      "grid-cards": 0.1,
      "characters": 0.03,
      "words": 0.05,
      "rows": 0.08
    }
  },

  "noise": {
    "opacity": 0.04,
    "base-frequency": 0.9,
    "octaves": 4
  },

  "logo": {
    "nav-size": "48px",
    "footer-size": "24px",
    "clear-space": "1x checkmark height",
    "variants": {
      "light": "assets/brand/logo-light.png",
      "dark": "assets/brand/logo-dark.png"
    }
  }
}
