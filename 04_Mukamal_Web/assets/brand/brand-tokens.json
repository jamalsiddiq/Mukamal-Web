{
  "brand": "Mukamal",
  "tagline": "We Design Conversion.",
  "version": "1.0.0",

  "colors": {
    "bg": "#080808",
    "bg-elevated": "#0D0D0D",
    "bg-card": "#111111",
    "accent": "#C6F135",
    "accent-dim": "rgba(198, 241, 53, 0.15)",
    "accent-glow": "rgba(198, 241, 53, 0.06)",
    "text": "#F0EDE6",
    "text-dim": "#888888",
    "error": "#FF4D4D",
    "success": "#22C55E",
    "glass": "rgba(255, 255, 255, 0.04)",
    "glass-hover": "rgba(255, 255, 255, 0.06)",
    "border": "rgba(255, 255, 255, 0.08)",
    "border-hover": "rgba(255, 255, 255, 0.12)"
  },

  "typography": {
    "font-display": "'Bebas Neue', sans-serif",
    "font-body": "'DM Sans', sans-serif",
    "font-mono": "'Space Mono', monospace",
    "scale": {
      "hero": { "desktop": "clamp(100px, 12vw, 160px)", "mobile": "clamp(56px, 14vw, 80px)" },
      "h1": { "desktop": "96px", "mobile": "56px" },
      "h2": { "desktop": "72px", "mobile": "40px" },
      "h3": { "desktop": "36px", "mobile": "28px" },
      "h4": { "desktop": "24px", "mobile": "20px" },
      "body-lg": "20px",
      "body": "16px",
      "body-sm": "14px",
      "label": "12px"
    },
    "line-height": {
      "display": 0.9,
      "heading": 1.0,
      "body": 1.7,
      "label": 1.3
    }
  },

  "spacing": {
    "unit": 8,
    "scale": {
      "xs": "8px",
      "sm": "16px",
      "md": "24px",
      "lg": "32px",
      "xl": "48px",
      "2xl": "64px",
      "3xl": "80px",
      "4xl": "120px",
      "5xl": "160px"
    }
  },

  "layout": {
    "max-width": "1400px",
    "content-padding": "48px",
    "content-padding-mobile": "24px",
    "grid-columns": { "desktop": 12, "mobile": 4 },
    "grid-gutter": "24px"
  },

  "radius": {
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "pill": "100px"
  },

  "shadows": {
    "card-hover": "0 8px 32px rgba(0, 0, 0, 0.3)",
    "glow": "0 0 40px rgba(198, 241, 53, 0.1)",
    "hero": "0 40px 100px rgba(0, 0, 0, 0.5)"
  },

  "opacity": {
    "headline": 1.0,
    "subheading": 0.7,
    "body": 0.87,
    "label": 0.6
  },

  "animation": {
    "easing": {
      "reveal": "power3.out",
      "state-change": "power2.inOut",
      "playful": "elastic.out(1, 0.3)",
      "hero": "power4.out"
    },
    "duration": {
      "hero-total": 1.5,
      "section-reveal": 0.8,
      "micro": 0.3,
      "count-up": 2.0
    },
    "stagger": {
      "grid-cards": 0.1,
      "characters": 0.03,
      "words": 0.05,
      "rows": 0.08
    }
  },

  "logo": {
    "nav-size": "48px",
    "footer-size": "24px",
    "clear-space": "1x checkmark height",
    "variants": {
      "light": "assets/brand/logo-light.png",
      "dark": "assets/brand/logo-dark.png"
    }
  },

  "noise": {
    "opacity": 0.035,
    "base-frequency": 0.85,
    "octaves": 4
  }
}
